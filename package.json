{
	"name": "agent-rules",
	"license": "MIT",
	"private": true,
	"description": "Map, house rules, hooks, lint, verify, and rule-owner PR review.",
	"packageManager": "pnpm@10.20.0",
	"type": "module",
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"scripts": {
		"lint": "eslint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test:tooling": "node --test tooling/*/*.test.node.mjs",
		"prepare": "lefthook install",
		"verify": "bash scripts/check-map.sh && pnpm lint && pnpm test:tooling"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"globals": "^17.9.0",
		"lefthook": "^2.1.10",
		"typebox": "1.3.7",
		"typescript-eslint": "^8.66.0"
	}
}
